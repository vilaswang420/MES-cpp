# ===== mes-backend 国内离线构建版 (Linux/Ubuntu, 见 docs/DEPLOY_CHINA.md) =====
# 核心思路: 宿主机完成全部编译 (vcpkg + cmake), Docker 只打包最终二进制。
# 构建过程 100% 无外网访问, 仅用阿里云 apt 源装运行时库。
# 构建: docker build -f deploy/backend/Dockerfile.cn -t mes-backend:latest .
# 注意: 构建上下文 = 仓库根目录
#
# 国内 Docker 镜像加速 (解决 docker.io 拉取超时):
#   服务器在国内直连 docker.io 会超时 (dial tcp i/o timeout)。
#   需在 /etc/docker/daemon.json 中配置 registry-mirrors:
#     腾讯云: https://mirror.ccs.tencentyun.com
#     阿里云: https://<your-id>.mirror.aliyuncs.com
#   配置后执行: sudo systemctl restart docker
#   注意: daemon.json 需保留原有配置项 (log-driver, storage-driver 等), 仅追加 registry-mirrors 字段。

# ---- 阶段: 打包 (无任何外部下载) ----
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# 切换阿里云 apt 源 (Ubuntu 24.04 使用 deb822 格式)
# libkrb5-3/libldap2: libpq 客户端库运行时可能动态链接, 容器内缺失会导致加载 libpq.so 失败
RUN sed -i 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g; s|http://security.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g' /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get update && apt-get install -y --no-install-recommends \
        libssl3 zlib1g ca-certificates tzdata \
        libkrb5-3 libldap2 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 宿主机制作好的二进制 (scripts/build_cn.sh 产出, 动态链接 x64-linux-dynamic)
COPY build-out/cmake/mes-backend ./mes-backend
# 动态链接产物: 一并打包 vcpkg 依赖的 .so (LD_LIBRARY_PATH 让加载器全局可寻, 含传递依赖)
# 注意: hiredis 的 debug 版本 libhiredisd.so 被 CMake 链接到 Release 产物中,
# 需同时 COPY release 和 debug 两个目录的 .so 文件
COPY build-out/cmake/vcpkg_installed/x64-linux-dynamic/lib/*.so* /app/lib/
COPY build-out/cmake/vcpkg_installed/x64-linux-dynamic/debug/lib/*.so* /app/lib/
ENV LD_LIBRARY_PATH=/app/lib
COPY mes-backend/config/drogon_config.prod.json /app/config/drogon_config.json
COPY mes-backend/config/rabbitmq.json /app/config/rabbitmq.json
RUN mkdir -p /app/logs /app/uploads

EXPOSE 8088
HEALTHCHECK --interval=10s --timeout=3s --retries=6 \
    CMD ["sh", "-c", "exec 3<>/dev/tcp/127.0.0.1/8088 && printf 'GET /healthz HTTP/1.0\\r\\n\\r\\n' >&3 && grep -q ok <&3"]
CMD ["./mes-backend", "config/drogon_config.json"]
